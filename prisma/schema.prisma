// Prisma 7: the connection URL lives in prisma.config.ts, not here.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Catalog cache pulled from Haravan.
/// Keyed by variantId because Haravan allows duplicate and null SKUs.
model VariantCache {
  variantId      BigInt  @id
  productId      BigInt
  sku            String?
  barcode        String?
  productTitle   String
  variantTitle   String?
  price          Float
  compareAtPrice Float?
  inventoryQty   Int?

  // Fields taken from the parent product.
  publishedAt       DateTime? // null = not published yet -> rule B2
  notAllowPromotion Boolean   @default(false) // product excluded from promotions -> rule B6
  publishedScope    String? // 'global' | 'pos' | null - stored, not used yet

  syncedAt DateTime

  @@index([sku])
  @@index([productId])
}

model SyncState {
  id                Int       @id @default(1)
  lastFullSyncAt    DateTime?
  lastCursor        DateTime? // feeds updated_at_min on the next incremental sync
  productCount      Int       @default(0)
  variantCount      Int       @default(0)
  blankSkuCount     Int       @default(0)
  duplicateSkuCount Int       @default(0)
}

model CheckRun {
  id             String   @id @default(cuid())
  mode           String // "check" | "reconcile"
  fileName       String // original upload name
  storedFileName String? // MinIO object key, or a name inside UPLOAD_DIR; null = not kept
  fileHash       String
  createdAt      DateTime @default(now())

  totalSheets   Int
  totalRows     Int
  totalPrograms Int
  countCritical Int @default(0)
  countDanger   Int @default(0)
  countWarn     Int @default(0)

  catalogSyncedAt DateTime? // catalog freshness snapshot at run time
  findings        Finding[]
  programs        CheckProgram[]
  matches         ReconcileMatch[] // populated only when mode = "reconcile"

  @@index([createdAt]) // history list, newest first
  @@index([fileHash]) // "this file was already checked" lookup
}

/// One promotion program as it appeared in the uploaded file.
///
/// Stored rather than recomputed because the result screen must show every
/// program - including the clean ones - and its row count, long after the
/// uploaded file has been pruned from disk.
model CheckProgram {
  id       String   @id @default(cuid())
  runId    String
  run      CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name     String
  rowCount Int

  countCritical Int @default(0)
  countDanger   Int @default(0)
  countWarn     Int @default(0)

  @@unique([runId, name]) // also serves as the per-run lookup index
}

/// One Excel program lined up against what Haravan actually holds.
///
/// Stored per (program, Haravan promotion) pair rather than per program, because
/// Haravan allows duplicate promotion names: an ambiguous match writes one row
/// per candidate so the screen can list them all instead of picking one.
///
/// Both sides are snapshotted rather than recomputed. The three-column diff has
/// to still be readable months later, long after the promotion has been edited
/// on Haravan and the uploaded file pruned from disk.
model ReconcileMatch {
  id          String   @id @default(cuid())
  runId       String
  run         CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  programName String
  status      String // "matched" | "not-found" | "ambiguous" | "extra-on-haravan"

  // Excel side. All null for a promotion that only exists on Haravan.
  excelRowCount     Int?
  /// Distinct usable SKUs, i.e. what Haravan actually receives. Compared by rule F5.
  excelSkuCount     Int?
  excelDiscountType String? // "fixed_amount" | "percentage" | "same_price"
  excelValue        Float? // amount in dong, or percent already scaled to 0-100
  excelStartAt      DateTime?
  excelEndAt        DateTime?

  // Haravan side. All null when nothing matched the name.
  haravanId           String? // kept as text: an id is an identifier, never arithmetic
  haravanTakeType     String? // "fixed_amount" | "percentage"
  haravanValue        Float?
  haravanStartAt      DateTime?
  haravanEndAt        DateTime?
  haravanStatus       String? // "enabled" | "disabled"
  /// Variants resolved from entitled_variant_ids + entitled_product_ids.
  /// null = the catalog cache could not resolve them, so no conclusion was drawn.
  haravanVariantCount Int?
  /// True when the promotion attaches whole products rather than single variants.
  haravanByProduct    Boolean   @default(false)

  @@index([runId, programName])
}

model Finding {
  id          String   @id @default(cuid())
  runId       String
  run         CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ruleCode    String
  severity    String // "critical" | "danger" | "warn"
  sheetName   String?
  rowNumber   Int? // real Excel row number, header row included
  programName String?
  sku         String?
  message     String
  suggestion  String?

  @@index([runId, severity])
  @@index([runId, ruleCode])
  @@index([runId, programName])
}

model RuleConfig {
  code      String   @id // "A1", "B1", ...
  groupCode String // "A".."F"
  title     String
  enabled   Boolean  @default(true)
  severity  String
  params    Json? // per-rule thresholds
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key   String @id
  value String
}

/// An operator allowed to use the tool.
///
/// `username` and `email` are both stored lower-cased, because login accepts
/// either one and "Hoa" and "hoa" must not be able to become two accounts.
model User {
  id           String @id @default(cuid())
  username     String @unique
  email        String @unique
  passwordHash String

  /// Consecutive failed logins. Reset to 0 by a successful one.
  failedAttempts Int       @default(0)
  /// Set once failedAttempts crosses the configured limit; null = not locked.
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  sessions Session[]
}

/// One logged-in browser.
///
/// Keyed by the SHA-256 of the cookie token rather than the token itself: whoever
/// reads this table still cannot rebuild a cookie that would pass verification.
///
/// Sessions live in the database rather than in a signed cookie so that deleting
/// an account, or logging out, takes effect immediately instead of at expiry.
model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt]) // sweeping expired rows
}
