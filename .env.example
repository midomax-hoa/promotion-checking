# PostgreSQL connection string.
# URL-encode special characters in the password: "@" must be written as "%40".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/promotion_checking"

# Haravan private app token - server side only, never prefix with NEXT_PUBLIC_.
HARAVAN_API_TOKEN=

# Where uploaded .xlsx files are kept so reports can be re-exported (phase 05/08).
UPLOAD_DIR=.uploads

# First administrator account, used only by `npm run db:seed` and only while the
# user table is still empty. Leave blank and run `npm run user:create` instead.
AUTH_SEED_USERNAME=
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=

# --- MinIO (kho đối tượng) ---
# CHỈ có tác dụng khi NODE_ENV=production. Chạy `next dev` hay chạy test thì
# file luôn ghi xuống UPLOAD_DIR ở trên, dù các biến dưới đây điền đủ - để
# không ai lỡ tay đẩy file thử nghiệm vào bucket của bản chạy thật.
# Trên production: bỏ trống MINIO_ENDPOINT thì vẫn ghi xuống UPLOAD_DIR; điền
# vào thì lưu lên MinIO. Điền một nửa sẽ báo lỗi thay vì lặng lẽ ghi ra đĩa.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=zma-assets
MINIO_USE_SSL=false
# Thư mục con trong bucket (bucket dùng chung với dự án khác nên phải có góc riêng).
MINIO_PREFIX=promotion-checking/uploads
# MINIO_PUBLIC_URL cố tình KHÔNG dùng: file chứa giá vốn, giá bán - không phát
# hành liên kết công khai, mọi lượt đọc đi qua server sau lớp kiểm tra phiên.
