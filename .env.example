# PostgreSQL connection string.
# URL-encode special characters in the password: "@" must be written as "%40".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/promotion_checking"

# Haravan private app token - server side only, never prefix with NEXT_PUBLIC_.
HARAVAN_API_TOKEN=

# Where uploaded .xlsx files are kept so reports can be re-exported (phase 05/08).
UPLOAD_DIR=.uploads

# First administrator account, used only by `npm run db:seed` and only while the
# user table is still empty. Leave blank and run `npm run user:create` instead.
AUTH_SEED_USERNAME=
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=
