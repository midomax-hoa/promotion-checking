# The list of variables a production deployment needs. NEVER commit the filled-in
# copy.
#
# On Dokploy: paste these into the Environment tab. Dokploy writes them to a
# `.env` file beside docker-compose.yml, which is what the stack reads.
# By hand: copy this file to `.env` and fill it in - `docker compose` picks
# `.env` up on its own, so no --env-file flag is needed.

# Published domain. Declare the same value in Dokploy's Domains tab, which is
# what actually routes traffic and issues the TLS certificate.
#
# It is ALSO baked into the image as the Server Action allowed origin, so
# changing it requires a rebuild, not just a restart. Skip the rebuild and the
# app still loads and logs in, but every Save button fails with
# `Invalid Server Actions request`.
APP_DOMAIN=promotion.noi-bo.example.com

# PostgreSQL on a separate, shared server - the connection details come from
# whoever administers it. URL-encode special characters in the password: @ -> %40.
# Keep sslmode=require when the traffic leaves the host.
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/promotion_checking?sslmode=require

# Haravan private app token. Read-only scopes are enough; the code never writes.
HARAVAN_API_TOKEN=

# Nơi lưu file upload khi KHÔNG dùng MinIO. Khớp với volume trong
# docker-compose.yml - đổi thì đổi cả hai. Khi MINIO_ENDPOINT có giá trị thì
# file lên MinIO và biến này chỉ còn dùng để đọc lại các lần chạy cũ.
UPLOAD_DIR=/data/uploads

# --- MinIO (kho đối tượng) ---
# Nơi lưu file Excel người dùng tải lên. Có endpoint thì lưu lên MinIO, để
# trống thì rơi về UPLOAD_DIR ở trên. Điền một nửa sẽ báo lỗi thay vì lặng lẽ
# ghi ra đĩa - đó luôn là cấu hình sai.
# Chỉ có tác dụng khi NODE_ENV=production; ảnh Docker đã đặt sẵn giá trị này,
# còn máy phát triển thì luôn ghi xuống thư mục local.
MINIO_ENDPOINT=minio.noi-bo.example.com
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=zma-assets
MINIO_USE_SSL=false
# Thư mục con trong bucket. Bucket dùng chung với dự án khác nên dự án này phải
# nằm gọn trong một góc; khoá nằm ngoài prefix bị từ chối cả khi ghi lẫn khi đọc.
MINIO_PREFIX=promotion-checking/uploads
# MINIO_PUBLIC_URL cố tình KHÔNG dùng: file chứa giá vốn, giá bán - không phát
# hành liên kết công khai, mọi lượt đọc đi qua server sau lớp kiểm tra phiên.

# Days an uploaded .xlsx is kept before scripts/prune-uploads.sh deletes it.
# Lưu ý: script dọn hiện chỉ quét volume /data/uploads, CHƯA dọn file trên MinIO.
# After that a report can no longer be re-exported from that run; the result
# screen says so instead of failing.
UPLOAD_RETENTION_DAYS=90

# First administrator account. `npm run db:seed` reads these once, while the user
# table is still empty, so a fresh deployment has something to log in with.
# Blank it out after the first successful login - it is not needed again, and
# further accounts are created with `npm run user:create` on the server.
AUTH_SEED_USERNAME=admin
AUTH_SEED_EMAIL=admin@example.com
AUTH_SEED_PASSWORD=
