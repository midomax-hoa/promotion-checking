# Copy to docker-compose.override.yml to adjust the stack for one machine.
# Compose picks the override up automatically; it is gitignored, so local
# tweaks never travel to another server.
#
# Not used by a Dokploy deployment - Dokploy composes the file itself. This is
# for running the stack by hand, usually to reproduce a problem locally.
#
# Everything below is commented out on purpose - uncomment only what you need.

services:
  # app:
  #   # Reach the app directly. Useful when a request works on :3000 but not
  #   # through the published domain: that narrows the fault down to the proxy
  #   # rather than the app. Remove again afterwards - the deployed stack
  #   # publishes nothing to the host.
  #   ports:
  #     - "127.0.0.1:3000:3000"
  #
  #   # Outside Dokploy the `dokploy-network` network does not exist. Listing
  #   # only `default` here detaches the app from it; if compose still complains
  #   # about the missing external network, delete the top-level `networks:`
  #   # block from docker-compose.yml for this machine as well.
  #   networks:
  #     - default

  # migrate:
  #   # Skip the seed and apply migrations only, when the rule defaults on this
  #   # database were deliberately tuned and must not be touched.
  #   command: ["-c", "npx prisma migrate deploy"]
